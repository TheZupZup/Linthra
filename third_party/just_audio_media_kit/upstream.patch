+    } else if (error == 'Failed to recognize file format.' && _mediaOpened) {
+      message = 'Unsupported audio: the file format was not recognized';
+    } else {
+      return;
+    }
+    pending.completeError(
+      PlatformException(code: '$kErrorCode', message: message),
+    );
+  }
