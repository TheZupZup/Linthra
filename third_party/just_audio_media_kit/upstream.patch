+  /// Fails the load in progress when libmpv reports it can't be opened.
+  ///
+  /// libmpv reports a source it cannot open (a missing file, an HTTP error, a
+  /// refused connection) or a file it cannot recognize only as an error log
+  /// and an idle core. Neither moves `buffering` back to false, which is the
+  /// only thing that completes [_loadCompleter], so without this [load] (and
+  /// with it just_audio's `setUrl`) never returns at all.
+  ///
+  /// The error carries fixed text, never libmpv's: libmpv's names the file, or
+  /// the full stream URL with whatever credentials it holds. "Failed to open"
+  /// counts only for a uri this load opened, so a late report about a source
+  /// it replaced can't fail it. "Failed to recognize file format" names no
+  /// source, so it counts only once this load's open has returned, after the
+  /// one it replaced was stopped.
+  void _failPendingLoad(String error) {
+    final Completer<Duration?>? pending = _loadCompleter;
+    if (pending == null || pending.isCompleted) return;
+    final String? failedUri =
+        RegExp(r'^Failed to open (.*)\.$').firstMatch(error)?[1];
+    final String message;
+    if (failedUri != null && _loadingUris.contains(failedUri)) {
