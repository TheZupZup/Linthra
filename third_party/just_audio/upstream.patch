+    // Linthra patch (#674): Media3 does not treat "this source has audio but no
+    // renderer can decode it" as an error. It drops the audio track, reaches
+    // READY and advances position on a wall-clock timer with no AudioTrack at
+    // all, so the app sees a normal playing state while nothing is heard.
+    // Report it as a load/playback error instead, and stop the player so it
+    // cannot keep "playing" silently. Returns whether the source is (already)
+    // reported as unsupported.
+    //
+    // The message carries only the sample MIME type (e.g. "audio/flac"): never
+    // the URI, which can contain credentials.
+    private boolean reportUnsupportedAudio(Tracks tracks) {
+        if (unsupportedAudioReported) return true;
+        if (!tracks.containsType(C.TRACK_TYPE_AUDIO) || tracks.isTypeSelected(C.TRACK_TYPE_AUDIO)) {
+            return false;
+        }
+        String mimeType = null;
+        for (Tracks.Group group : tracks.getGroups()) {
+            if (group.getType() == C.TRACK_TYPE_AUDIO && group.length > 0) {
+                mimeType = group.getTrackFormat(0).sampleMimeType;
+                break;
+            }
+        }
+        unsupportedAudioReported = true;
+        Log.w(TAG, "No audio renderer on this device can decode " + mimeType);
+        sendError(
+                String.valueOf(PlaybackException.ERROR_CODE_DECODING_FORMAT_UNSUPPORTED),
+                "Unsupported audio format: no decoder on this device for " + mimeType,
+                mapOf("index", currentIndex, "mimeType", mimeType));
+        player.stop();
+        return true;
+    }
