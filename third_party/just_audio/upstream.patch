+    // Linthra patch (#674): Media3's extension renderers are appended *after*
+    // the platform MediaCodec renderers (EXTENSION_RENDERER_MODE_ON, not
+    // PREFER), and the track selector only moves past a renderer that does not
+    // fully handle the format. So a device whose platform decodes a format keeps
+    // using it, and an extension renderer bundled with the app (Linthra ships
+    // Media3's FLAC one) is used only where the platform cannot. With no
+    // extension bundled this is identical to the default factory.
+    private DefaultRenderersFactory buildRenderersFactory() {
+        return new DefaultRenderersFactory(context)
